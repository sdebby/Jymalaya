# Jymalaya AI Coach configuration. Copy to .env and fill in the blanks:
#
#   cp .env.example .env
#
# .env is gitignored and never enters the container image -- it is read at
# runtime via env_file. Nothing here is logged or sent anywhere except each
# service's own endpoint.

# --- Garmin Personal API -- workouts, HRV, resting HR -------------------------
# Required for syncing. Create the key on the "Personal API Key" page in Garmin
# Connect (account settings). Keys expire (30 days to a year): when one does,
# the dashboard asks for a new one and saves it here.
GARMIN_PERSONAL_API_KEY=

# --- Garmin Connect (unofficial login) -- VO2max only -------------------------
# The Personal API has no VO2max, so the VO2max panel still uses this login.
# Optional: without it the panel just stops updating. MFA codes are entered in
# the dashboard's modal.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Claude API -- your own Anthropic key (sk-ant-...) ------------------------
# Required for the 7-day plan and the coach chat.
ANTHROPIC_API_KEY=
# Model for plan generation + workout analysis (optional; unset = claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model for the coach chat (optional; this is the default)
ANTHROPIC_COACH_MODEL=claude-sonnet-5-5
# Max output tokens per call (optional; these are the defaults).
# Plan generation streams, so a large value is safe; it must fit the whole 7-day
# plan JSON. Coach replies are short chat messages.
ANTHROPIC_PLAN_MAX_TOKENS=16000
ANTHROPIC_COACH_MAX_TOKENS=2048
# One post-workout analysis: a single session review, much smaller than a plan.
ANTHROPIC_ANALYSIS_MAX_TOKENS=4000
# Effort per call: low | medium | high | xhigh | max (optional; leave unset for
# the API default, "high"). Lower = terser/faster/cheaper plans and coach
# replies. xhigh requires Sonnet 5 or Opus 4.7+. On Sonnet 5.5 the calls run
# with thinking set to between_tools, which allows low/medium/high only, so
# xhigh and max are sent as high there.
ANTHROPIC_EFFORT=medium

# --- intervals.icu -- the bridge behind the dashboard's "Send to device" -----
# API key from intervals.icu Settings > Developer Settings. A sent session lands
# on your intervals.icu calendar; intervals.icu pushes it to Garmin Connect when
# its Garmin "upload planned workouts" option is on. Run steps are % LTHR, so
# keep the LTHR in intervals.icu equal to the one in Settings here.
INTERVALS_API_KEY=

# --- InfluxDB 2.x ------------------------------------------------------------
# For the dev setup and the two-container stack: CHANGE THE TOKEN AND PASSWORD. They are also the InfluxDB admin credentials,
# and they are applied only on the very first start against an empty volume --
# editing them later does not re-provision the database.
INFLUXDB_TOKEN=change-me-to-a-long-random-string
INFLUXDB_PASSWORD=change-me
INFLUXDB_USERNAME=admin
INFLUXDB_ORG=tricoach
INFLUXDB_BUCKET=tricoach
# Only used when running the backend outside Docker (start.cmd). The container
# stack overrides this with http://influxdb:8086.
INFLUXDB_URL=http://localhost:8086

# --- App ---------------------------------------------------------------------
# Host port the dashboard is served on: http://localhost:<APP_PORT>
APP_PORT=8080
# Timezone the container runs on -- the athlete's, since plan freshness is
# decided per calendar day.
TZ=Asia/Jerusalem
# DEBUG dumps the full Claude request/response bodies; INFO is the container default.
LOG_LEVEL=INFO
# Extra browser origins allowed to call the API. Only needed when the dashboard
# is served from somewhere other than this backend (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
